{
  "name": "ethiostart",
  "version": "0.1.0",
  "private": true,
  "description": "EthioStar Coffee Processing Management System (CPMS) — Phase 1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:int": "vitest run --project=integration",
    "test:cov": "vitest run --project=unit --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff --linked",
    "db:check": "drizzle-kit check",
    "db:seed": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs --conditions=react-server db/seeds/index.ts",
    "seed:demo": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs --conditions=react-server db/seeds/index.ts --demo",
    "guard:service-role": "tsx scripts/guard-service-role.ts",
    "verify": "npm run typecheck && npm run lint && npm run boundaries && npm run guard:service-role && npm run test"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.6.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "nodemailer": "^7.0.13",
    "pino": "^9.13.1",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "fast-check": "^4.3.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
